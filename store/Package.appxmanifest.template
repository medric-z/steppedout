<?xml version="1.0" encoding="utf-8"?>
<!--
  The Store package's manifest. tools/store/build.ps1 fills the placeholders and writes the result
  into each package as AppxManifest.xml:
    __STORE_NAME__       Package/Identity/Name, from Partner Center's Product identity page
    __STORE_PUBLISHER__  Package/Identity/Publisher, from the same page (starts with CN=)
    __STORE_DISPLAY__    Package/Properties/PublisherDisplayName, from the same page
    __APP_NAME__         the name reserved in Partner Center (SteppedOut unless that was taken)
    __VERSION__          the app's version with a fourth part of 0, which the Store requires
    __ARCH__             x64 or arm64
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="__STORE_NAME__"
    Publisher="__STORE_PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="__ARCH__" />

  <Properties>
    <DisplayName>__APP_NAME__</DisplayName>
    <PublisherDisplayName>__STORE_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 10 version 1809, the first with full MSIX support. The app's .NET runtime goes back to
       1607, but a .msix bundle cannot target anything older than this. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The first language is the default. The Store offers a listing for each one. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ar" />
  </Resources>

  <Applications>
    <Application Id="SteppedOut" Executable="SteppedOut.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="__APP_NAME__"
        Description="Locks your PC when you walk away from it."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start with Windows. Off until the user turns it on in the app; Windows then lists it
             under Settings, Apps, Startup. The app reads and changes it by this TaskId. -->
        <desktop:Extension Category="windows.startupTask" Executable="SteppedOut.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="SteppedOutStartup" Enabled="false" DisplayName="__APP_NAME__" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
