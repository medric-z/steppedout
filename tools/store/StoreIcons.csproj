<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the Store package's icons from the app's own logo code, and pins the packaging tools.
       Run by tools/store/build.ps1. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <AssemblyName>SteppedOut.StoreIcons</AssemblyName>
    <RootNamespace>StoreIcons</RootNamespace>
    <!-- The lock file records the packaging tools' content hash; build.ps1 restores in locked mode,
         so a package whose bytes differ from the recorded ones fails the restore. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SteppedOut.csproj" />
  </ItemGroup>

  <!-- makeappx and makepri, used only when no Windows SDK is installed. Nothing from it is compiled in. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

</Project>
